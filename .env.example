# Copy to .env and adjust as needed.

POSTGRES_USER=smscope
POSTGRES_PASSWORD=smscope
POSTGRES_DB=securemailscope
# Host-side port for Postgres. 5433 by default so it does not collide with a
# local Postgres install on 5432.
POSTGRES_PORT=5433

API_PORT=8000

# 2 GiB. Uploads are hostile input; keep a hard ceiling.
MAX_UPLOAD_BYTES=2147483648

# Wall-clock limit for any external tool invocation (capinfos, tshark, ...).
TOOL_TIMEOUT_SECONDS=300

CORS_ORIGINS=http://localhost:5173
